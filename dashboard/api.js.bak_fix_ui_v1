    const { dias = 30 } = req.query;
    const r = await query(`
      SELECT DATE(creado_en) as fecha,
             COUNT(*) as pedidos,
             COALESCE(SUM(total),0) as total
      FROM pedidos
      WHERE estado IN ('confirmado','entregado')
