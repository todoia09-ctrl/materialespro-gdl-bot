# ══════════════════════════════════════════
#  MaterialesPro GDL — Variables de entorno
#  Copia este archivo como .env y llena los valores
#  NUNCA subas .env a GitHub
# ══════════════════════════════════════════

# ── Anthropic (Claude IA) ──────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ── OpenAI (Whisper — transcripción de audio) ──
# Obtén tu key en: https://platform.openai.com/api-keys
# Solo se usa para notas de voz. Costo: ~$0.006 USD/minuto de audio
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXX

# ── Twilio WhatsApp ────────────────────────
# Obtén estos datos en: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número de Twilio WhatsApp Sandbox (no cambies esto en pruebas):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Servidor ──────────────────────────────
PORT=3000

# ── Meta (Facebook + Instagram) ───────────
# Page Access Token: developers.facebook.com → tu app → Messenger/Instagram → Page Access Token
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx

# Verify Token: invéntalo tú (cualquier palabra secreta, la misma que pones en Meta)
META_VERIFY_TOKEN=materialespro2024

# ── Búsqueda Técnica (fichas PDF + YouTube) ────
#
# OPCIÓN A: SerpAPI — más confiable, busca cualquier PDF
# Obtén tu key en: https://serpapi.com (plan gratis = 100 búsquedas/mes)
SERP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# OPCIÓN B: Google Custom Search — gratis 100 búsquedas/día
# 1. Crea motor en: https://programmablesearchengine.google.com
# 2. API Key en: https://console.cloud.google.com → Custom Search API
GOOGLE_SEARCH_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SEARCH_CX=xxxxxxxxxxxxxxxxx
#
# YouTube API — gratis 10,000 unidades/día (suficiente para empezar)
# Obtén tu key en: https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pedidos — Notificación al Vendedor ────────────
# Número WhatsApp del vendedor (sin whatsapp:, con código de país)
VENDOR_WHATSAPP=+523312345678

# Email del vendedor
VENDOR_EMAIL=vendedor@tunegocio.com

# Configuración email (usa Gmail o cualquier SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tunegocio@gmail.com
EMAIL_PASS=xxxxxxxxxxxx

# ── Datos bancarios para transferencias ───────────
BANK_NAME=BBVA
BANK_CLABE=012345678901234567
BANK_BENEFICIARY=MaterialesPro GDL SA de CV

# ── Cloudinary (hosting de PDFs) ──────────────────
# Obtén gratis en: https://cloudinary.com/users/register_free
# Free tier: 25GB almacenamiento — suficiente para miles de cotizaciones
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
